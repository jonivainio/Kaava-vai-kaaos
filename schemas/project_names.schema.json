{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schemaVersion",
    "poolVersion",
    "locale",
    "fictional",
    "notice",
    "names"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "poolVersion": {
      "type": "string"
    },
    "locale": {
      "const": "fi-FI"
    },
    "fictional": {
      "const": true
    },
    "notice": {
      "type": "string"
    },
    "names": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^N[0-9]{3}$"
          },
          "name": {
            "type": "string",
            "minLength": 4,
            "maxLength": 36,
            "pattern": "^[A-ZÅÄÖ][a-zåäö]+(?:suo|neva)$"
          }
        }
      }
    }
  }
}
